# Sources and policy only; Altivec owns compilation and packaging.
PRODUCTS = MyMacApp
MyMacApp_TYPE = app
MyMacApp_SOURCES = main.m AppDelegate.m
MyMacApp_PLIST = Resources/Info.plist
MyMacApp_RESOURCES = $(filter-out Resources/Info.plist,$(wildcard Resources/*))
MyMacApp_LDFLAGS = -framework AppKit -lobjc
# MyMacApp_CORE = static
# MyMacApp_COCOA = static
# ARCHS = ppc i386
include /altivec/altivec_common_mac.mk
