# Sources and policy only; Altivec owns compilation and packaging.
PRODUCTS = MyPhoneApp
MyPhoneApp_TYPE = app
MyPhoneApp_SIGN = 1
MyPhoneApp_SANDBOX = container
MyPhoneApp_SOURCES = main.m AppDelegate.m
MyPhoneApp_PLIST = Resources/Info.plist
MyPhoneApp_RESOURCES = $(filter-out Resources/Info.plist,$(wildcard Resources/*))
MyPhoneApp_LDFLAGS = -framework UIKit -framework Foundation -framework CoreGraphics
# MyPhoneApp_CORE = static
# MyPhoneApp_COCOA = static
# ARCHS = armv7
include /altivec/altivec_common_phone.mk
