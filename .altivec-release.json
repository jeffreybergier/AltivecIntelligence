{
  "app_name": "AltivecIntelligence",
  "tag_prefix": "v",
  "version": {
    "source": "apps/SingleWindow/Resources/Info.plist",
    "keys": [
      "CFBundleShortVersionString",
      "CFBundleVersion"
    ],
    "plists": [
      "apps/SingleWindow/Resources/Info.plist",
      "apps/SingleScreen/Resources/Info.plist",
      "apps/CURLmac/Resources/Info.plist",
      "apps/CURLphone/Resources/Info.plist",
      "libs/core/Resources/Info-mac.plist",
      "libs/cocoa/Resources/Info-mac.plist"
    ]
  },
  "release": {
    "commit_message": "chore(release): release {version}"
  },
  "targets": [
    {
      "name": "AltivecCore",
      "workdir": "libs/core",
      "build": [
        {
          "shell": "test -n \"$ALTIVEC_RELEASE_PREBUILT_ROOT\""
        },
        {
          "shell": "test -d \"$ALTIVEC_RELEASE_PREBUILT_ROOT/libs/core/build-mac/lib/AltivecCore.framework\""
        },
        {
          "shell": "test -f \"$ALTIVEC_RELEASE_PREBUILT_ROOT/libs/core/build-phone/lib/libAltivecCore.a\""
        },
        {
          "shell": "rm -rf build-release && mkdir -p build-release"
        },
        {
          "shell": "output=\"$(pwd)/build-release/AltivecCore-macOS.framework.zip\"; cd \"$ALTIVEC_RELEASE_PREBUILT_ROOT/libs/core/build-mac/lib\" && zip -rqy \"$output\" AltivecCore.framework"
        },
        {
          "shell": "rm -rf build-release/AltivecCore-iOS-static"
        },
        {
          "shell": "mkdir -p build-release/AltivecCore-iOS-static"
        },
        {
          "shell": "cp -R \"$ALTIVEC_RELEASE_PREBUILT_ROOT/libs/core/build-phone/lib\" build-release/AltivecCore-iOS-static/"
        },
        {
          "shell": "cp -R \"$ALTIVEC_RELEASE_PREBUILT_ROOT/libs/core/build-phone/include\" build-release/AltivecCore-iOS-static/"
        },
        {
          "shell": "cd build-release && zip -rqy AltivecCore-iOS-static.zip AltivecCore-iOS-static"
        }
      ],
      "artifacts": [
        {
          "path": "libs/core/build-release/AltivecCore-macOS.framework.zip",
          "asset_name": "AltivecCore-{version}-macOS.framework.zip"
        },
        {
          "path": "libs/core/build-release/AltivecCore-iOS-static.zip",
          "asset_name": "AltivecCore-{version}-iOS-static.zip"
        }
      ]
    },
    {
      "name": "AltivecCocoa",
      "workdir": "libs/cocoa",
      "build": [
        {
          "shell": "test -n \"$ALTIVEC_RELEASE_PREBUILT_ROOT\""
        },
        {
          "shell": "test -d \"$ALTIVEC_RELEASE_PREBUILT_ROOT/libs/cocoa/build-mac/lib/AltivecCocoa.framework\""
        },
        {
          "shell": "test -f \"$ALTIVEC_RELEASE_PREBUILT_ROOT/libs/cocoa/build-phone/lib/libAltivecCocoa.a\""
        },
        {
          "shell": "rm -rf build-release && mkdir -p build-release"
        },
        {
          "shell": "output=\"$(pwd)/build-release/AltivecCocoa-macOS.framework.zip\"; cd \"$ALTIVEC_RELEASE_PREBUILT_ROOT/libs/cocoa/build-mac/lib\" && zip -rqy \"$output\" AltivecCocoa.framework"
        },
        {
          "shell": "rm -rf build-release/AltivecCocoa-iOS-static"
        },
        {
          "shell": "mkdir -p build-release/AltivecCocoa-iOS-static"
        },
        {
          "shell": "cp -R \"$ALTIVEC_RELEASE_PREBUILT_ROOT/libs/cocoa/build-phone/lib\" build-release/AltivecCocoa-iOS-static/"
        },
        {
          "shell": "cp -R \"$ALTIVEC_RELEASE_PREBUILT_ROOT/libs/cocoa/build-phone/include\" build-release/AltivecCocoa-iOS-static/"
        },
        {
          "shell": "cp -R \"$ALTIVEC_RELEASE_PREBUILT_ROOT/libs/cocoa/build-phone/Resources\" build-release/AltivecCocoa-iOS-static/"
        },
        {
          "shell": "cd build-release && zip -rqy AltivecCocoa-iOS-static.zip AltivecCocoa-iOS-static"
        }
      ],
      "artifacts": [
        {
          "path": "libs/cocoa/build-release/AltivecCocoa-macOS.framework.zip",
          "asset_name": "AltivecCocoa-{version}-macOS.framework.zip"
        },
        {
          "path": "libs/cocoa/build-release/AltivecCocoa-iOS-static.zip",
          "asset_name": "AltivecCocoa-{version}-iOS-static.zip"
        }
      ]
    },
    {
      "name": "AltivecCocoaSQLite",
      "workdir": "libs/cocoa-sqlite",
      "build": [
        {
          "shell": "python3 tools/package.py"
        }
      ],
      "artifacts": [
        {
          "path": "libs/cocoa-sqlite/build-release/AltivecCocoaSQLite-macOS-static.zip",
          "asset_name": "AltivecCocoaSQLite-{version}-macOS-static.zip"
        },
        {
          "path": "libs/cocoa-sqlite/build-release/AltivecCocoaSQLite-iOS-static.zip",
          "asset_name": "AltivecCocoaSQLite-{version}-iOS-static.zip"
        }
      ]
    },
    {
      "name": "SingleWindow",
      "workdir": "apps/SingleWindow",
      "build": [
        {
          "shell": "make clean"
        },
        {
          "shell": "ALTIVEC_ROOT=\"$ALTIVEC_RELEASE_PREBUILT_ROOT\" make release"
        }
      ],
      "artifact": "apps/SingleWindow/build/macOS/release/SingleWindow/SingleWindow.zip",
      "asset_name": "SingleWindow-{version}.zip"
    },
    {
      "name": "SingleScreen",
      "workdir": "apps/SingleScreen",
      "build": [
        {
          "shell": "make clean"
        },
        {
          "shell": "ALTIVEC_ROOT=\"$ALTIVEC_RELEASE_PREBUILT_ROOT\" make release"
        }
      ],
      "artifact": "apps/SingleScreen/build/iOS/release/SingleScreen/SingleScreen.ipa",
      "asset_name": "SingleScreen-{version}.ipa"
    },
    {
      "name": "CURLmac",
      "workdir": "apps/CURLmac",
      "build": [
        {
          "shell": "make clean"
        },
        {
          "shell": "ALTIVEC_ROOT=\"$ALTIVEC_RELEASE_PREBUILT_ROOT\" make release"
        }
      ],
      "artifact": "apps/CURLmac/build/macOS/release/CURLmac/CURLmac.zip",
      "asset_name": "CURLmac-{version}.zip"
    },
    {
      "name": "CURLphone",
      "workdir": "apps/CURLphone",
      "build": [
        {
          "shell": "make clean"
        },
        {
          "shell": "ALTIVEC_ROOT=\"$ALTIVEC_RELEASE_PREBUILT_ROOT\" make release"
        }
      ],
      "artifact": "apps/CURLphone/build/iOS/release/CURLphone/CURLphone.ipa",
      "asset_name": "CURLphone-{version}.ipa"
    },
    {
      "name": "AltivecToolchain",
      "workdir": "toolchain/iOS/armv7",
      "build": [
        {
          "shell": "version=\"$(../../../bin/altivec-release current)\"; make release DEB_VERSION=\"$version\" DEB_OUTPUT=build-release/AltivecToolchain-iOS-armv7.deb"
        }
      ],
      "artifact": "toolchain/iOS/armv7/build-release/AltivecToolchain-iOS-armv7.deb",
      "asset_name": "AltivecToolchain-{version}-iOS-armv7.deb"
    }
  ],
  "schema_version": 1,
  "stage_dir": "build/release/artifacts"
}
