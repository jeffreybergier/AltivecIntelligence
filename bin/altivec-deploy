#!/usr/bin/env node
"use strict";

const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const readline = require("node:readline/promises");
const { spawn } = require("node:child_process");

const ALTIVEC_ROOT = path.resolve(__dirname, "..");
const GDBINIT_FILE = path.join(ALTIVEC_ROOT, "templates", "gdbinit");
const LLDBINIT_FILE = path.join(ALTIVEC_ROOT, "templates", "lldbinit");
const REMOTE_MAC_PARENT = "Desktop/Altivec";
const REMOTE_IOS_PARENT = "tmp_altivec";
const DEFAULT_TIMEOUT = 60;

let activeChild = null;
let stopRequested = false;
const stopWaiters = new Set();

class DeployError extends Error {
  constructor(message, status = 1) {
    super(message);
    this.name = "DeployError";
    this.status = status;
  }
}

function logHeader(message) {
  process.stdout.write(`\n=== ${message} ===\n`);
}

function logItem(message) {
  process.stdout.write(` > ${message}\n`);
}

function logFail(message) {
  process.stderr.write(`[FAIL] ${message}\n`);
}

function usage(scriptName = process.argv[1]) {
  return [
    `Usage: ${scriptName} <path_to_app_or_build_dir> --device <user@host> [options]`,
    "",
    "Options:",
    "  -d, --device <user@host>  Required SSH deployment target",
    "  -y, --yes [seconds]       Skip confirmation and debugger",
    "      --timeout <seconds>   Set non-interactive timeout (default: 60)",
    "  -h, --help                Show this help",
  ].join("\n");
}

function positiveInteger(value, option) {
  if (!/^\d+$/.test(value || "") || Number(value) <= 0) {
    throw new DeployError(`${option} requires a positive number of seconds`);
  }
  return Number(value);
}

function parseArgs(argv) {
  if (argv.length === 0) throw new DeployError("Missing application path");
  if (argv[0] === "-h" || argv[0] === "--help") return { help: true };
  if (argv[0].startsWith("-")) {
    throw new DeployError("The application path must be the first argument");
  }
  const options = {
    help: false,
    inputPath: path.resolve(argv[0]),
    device: null,
    nonInteractive: false,
    timeout: DEFAULT_TIMEOUT,
  };
  for (let index = 1; index < argv.length; index += 1) {
    const argument = argv[index];
    if (argument === "-h" || argument === "--help") {
      options.help = true;
    } else if (argument === "-d" || argument === "--device") {
      const device = argv[index + 1];
      if (!device || device.startsWith("-")) {
        throw new DeployError(`${argument} requires a user@host value`);
      }
      options.device = device;
      index += 1;
    } else if (argument === "-y" || argument === "--yes") {
      options.nonInteractive = true;
      if (/^\d+$/.test(argv[index + 1] || "")) {
        options.timeout = positiveInteger(argv[index + 1], argument);
        index += 1;
      }
    } else if (argument === "--timeout") {
      options.timeout = positiveInteger(argv[index + 1], argument);
      index += 1;
    } else {
      throw new DeployError(`Unknown argument: ${argument}`);
    }
  }
  if (!options.help && !options.device) {
    throw new DeployError(
      "Missing required SSH target: use --device <user@host>",
    );
  }
  return options;
}

function requireConfirmationTerminal(options, input = process.stdin) {
  if (!options.nonInteractive && !input.isTTY) {
    throw new DeployError(
      "Confirmation requires an interactive terminal; rerun with --yes",
    );
  }
}

function signalStatus(signal) {
  if (signal === "SIGINT") return 130;
  if (signal === "SIGTERM") return 143;
  return 1;
}

function onSignal(signal) {
  if (activeChild) {
    activeChild.kill(signal);
    return;
  }
  stopRequested = true;
  for (const resolve of stopWaiters) resolve(signal);
  stopWaiters.clear();
}

process.on("SIGINT", () => onSignal("SIGINT"));
process.on("SIGTERM", () => onSignal("SIGTERM"));

function run(command, args, options = {}) {
  const {
    capture = false,
    allowFailure = false,
    stderr = capture ? "pipe" : "inherit",
  } = options;
  return new Promise((resolve, reject) => {
    const child = spawn(command, args, {
      stdio: ["inherit", capture ? "pipe" : "inherit", stderr],
    });
    let stdout = "";
    let errorOutput = "";
    activeChild = child;
    if (child.stdout) child.stdout.on("data", (chunk) => (stdout += chunk));
    if (child.stderr)
      child.stderr.on("data", (chunk) => (errorOutput += chunk));
    child.once("error", (error) => {
      if (activeChild === child) activeChild = null;
      reject(new DeployError(`${command}: ${error.message}`));
    });
    child.once("close", (status, signal) => {
      if (activeChild === child) activeChild = null;
      const result = {
        status: status ?? signalStatus(signal),
        signal,
        stdout,
        stderr: errorOutput,
      };
      if (result.status === 0 || allowFailure) return resolve(result);
      if (signal) {
        return reject(
          new DeployError("Deployment interrupted", signalStatus(signal)),
        );
      }
      const detail = errorOutput.trim();
      reject(
        new DeployError(
          `${command} exited with status ${result.status}${detail ? `: ${detail}` : ""}`,
          result.status,
        ),
      );
    });
  });
}

function waitForStop(timeout) {
  return new Promise((resolve) => {
    if (stopRequested) return resolve("SIGINT");
    let timer = null;
    const finish = (signal) => {
      if (timer) clearTimeout(timer);
      stopWaiters.delete(finish);
      resolve(signal);
    };
    stopWaiters.add(finish);
    if (Number.isFinite(timeout))
      timer = setTimeout(() => finish(null), timeout);
  });
}

async function waitOrAbort(timeout, child = null) {
  const signal = await waitForStop(timeout);
  if (!signal) return;
  await stopChild(child);
  throw new DeployError("Deployment interrupted", signalStatus(signal));
}

function directoryEntries(directory) {
  return fs
    .readdirSync(directory, { withFileTypes: true })
    .sort((left, right) => left.name.localeCompare(right.name));
}

function findAppBundles(inputPath, maxDepth = 2) {
  const input = fs.statSync(inputPath);
  if (input.isDirectory() && inputPath.endsWith(".app")) return [inputPath];
  if (!input.isDirectory()) return [];
  const matches = [];
  const visit = (directory, depth) => {
    for (const entry of directoryEntries(directory)) {
      if (!entry.isDirectory()) continue;
      const candidate = path.join(directory, entry.name);
      if (entry.name.endsWith(".app")) matches.push(candidate);
      else if (depth < maxDepth) visit(candidate, depth + 1);
    }
  };
  visit(inputPath, 1);
  return matches;
}

function selectArtifact(directory, appName, extension) {
  const candidates = directoryEntries(directory)
    .filter((entry) => entry.isFile() && entry.name.endsWith(extension))
    .map((entry) => path.join(directory, entry.name));
  const exact = candidates.find(
    (candidate) => path.basename(candidate) === `${appName}${extension}`,
  );
  if (exact) return exact;
  if (candidates.length <= 1) return candidates[0] || null;
  throw new DeployError(
    `Multiple ${extension} payloads found in ${directory}; expected ${appName}${extension}`,
  );
}

function findEnvFile(startDirectory, maxHops = 8) {
  let directory = path.resolve(startDirectory);
  for (let hop = 0; hop < maxHops; hop += 1) {
    const candidate = path.join(directory, ".env");
    if (fs.existsSync(candidate) && fs.statSync(candidate).isFile())
      return candidate;
    const parent = path.dirname(directory);
    if (parent === directory) break;
    directory = parent;
  }
  return null;
}

function parseEnv(contents) {
  const variables = [];
  for (const line of contents.split(/\r?\n/)) {
    if (!line || line.startsWith("#") || !line.includes("=")) continue;
    const separator = line.indexOf("=");
    const key = line.slice(0, separator).trim();
    if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(key)) continue;
    variables.push([key, line.slice(separator + 1)]);
  }
  return variables;
}

function quoteLldbToken(value) {
  return `"${value.replaceAll("\\", "\\\\").replaceAll('"', '\\"')}"`;
}

function buildDebuggerInit(template, variables, mode, envFile) {
  const lines = [];
  if (template) lines.push(template.replace(/\n$/, ""), "");
  if (variables.length > 0) {
    lines.push(`## auto-injected from ${envFile}`);
    for (const [key, value] of variables) {
      if (mode === "gdb") lines.push(`set environment ${key} ${value}`);
      else
        lines.push(
          `settings set target.env-vars ${quoteLldbToken(`${key}=${value}`)}`,
        );
    }
  }
  return `${lines.join("\n")}\n`;
}

function discoverApplication(inputPath) {
  logHeader("Application Preflight");
  if (!fs.existsSync(inputPath)) {
    throw new DeployError(`Application path does not exist: ${inputPath}`);
  }
  const bundles = findAppBundles(inputPath);
  if (bundles.length === 0) {
    throw new DeployError(`Could not find .app bundle in ${inputPath}`);
  }
  if (bundles.length > 1) {
    throw new DeployError(
      `Multiple .app bundles found; pass one explicitly:\n${bundles.map((item) => `       ${item}`).join("\n")}`,
    );
  }
  const bundlePath = bundles[0];
  const directory = path.dirname(bundlePath);
  const appName = path.basename(bundlePath, ".app");
  const ipaPath = selectArtifact(directory, appName, ".ipa");
  const zipPath = selectArtifact(directory, appName, ".zip");
  const dsymPaths = directoryEntries(directory)
    .filter((entry) => entry.isDirectory() && entry.name.endsWith(".dSYM"))
    .map((entry) => path.join(directory, entry.name));
  const gdbInit = fs.existsSync(GDBINIT_FILE) ? GDBINIT_FILE : null;
  const lldbInit = fs.existsSync(LLDBINIT_FILE) ? LLDBINIT_FILE : null;
  const envFile = findEnvFile(directory);

  logItem(`Found App: ${bundlePath}`);
  if (ipaPath) logItem(`Found IPA: ${path.basename(ipaPath)}`);
  if (zipPath) logItem(`Found ZIP: ${path.basename(zipPath)}`);
  for (const dsymPath of dsymPaths)
    logItem(`Found dSYM: ${path.basename(dsymPath)}`);
  logItem(
    gdbInit
      ? `Found gdbinit: ${gdbInit}`
      : `gdbinit: Not found (${GDBINIT_FILE})`,
  );
  logItem(
    lldbInit
      ? `Found lldbinit: ${lldbInit}`
      : `lldbinit: Not found (${LLDBINIT_FILE})`,
  );
  logItem(
    envFile
      ? `Found .env: ${envFile}`
      : ".env: Not found (no env-var injection)",
  );
  return {
    bundlePath,
    directory,
    appName,
    ipaPath,
    zipPath,
    dsymPaths,
    gdbInit,
    lldbInit,
    envFile,
    tempDirectory: null,
    gdbInitToUse: gdbInit,
    lldbInitToUse: lldbInit,
  };
}

function parseProbeOutput(output) {
  const values = new Map();
  for (const line of output.split(/\r?\n/)) {
    const separator = line.indexOf("=");
    if (separator >= 0)
      values.set(line.slice(0, separator), line.slice(separator + 1));
  }
  return values;
}

const REMOTE_PROBE = String.raw`
MY_UNAME=$(uname)
printf 'UNAME=%s\n' "$MY_UNAME"
if [ "$MY_UNAME" = Darwin ]; then
  [ -d /var/mobile ] && printf 'DEVTYPE=ios\n' || printf 'DEVTYPE=mac\n'
else
  printf 'DEVTYPE=%s\n' "$MY_UNAME"
fi
printf 'HOME=%s\n' "$HOME"
printf 'GDB=%s\n' "$(command -v gdb 2>/dev/null)"
printf 'LLDB=%s\n' "$(command -v lldb 2>/dev/null)"
printf 'APPINST=%s\n' "$(command -v appinst 2>/dev/null)"
printf 'IPAINST=%s\n' "$(command -v ipainstaller 2>/dev/null)"
MY_UID=$(id -u)
[ -f "/Library/Logs/Console/$MY_UID/console.log" ] && printf 'CONSOLE_LOG=/Library/Logs/Console/%s/console.log\n' "$MY_UID" || printf 'CONSOLE_LOG=\n'
[ -f /var/log/system.log ] && printf 'SYSLOG_MAC=/var/log/system.log\n' || printf 'SYSLOG_MAC=\n'
[ -f /var/log/syslog ] && printf 'SYSLOG_IOS=/var/log/syslog\n' || printf 'SYSLOG_IOS=\n'
`;

function deviceFromProbe(values, device) {
  const consoleLog = values.get("CONSOLE_LOG") || null;
  const macLog = values.get("SYSLOG_MAC") || null;
  const iosLog = values.get("SYSLOG_IOS") || null;
  return {
    device,
    os: values.get("UNAME") || "",
    type: values.get("DEVTYPE") || "",
    home: values.get("HOME") || "",
    gdb: values.get("GDB") || null,
    lldb: values.get("LLDB") || null,
    appinst: values.get("APPINST") || null,
    ipainstaller: values.get("IPAINST") || null,
    consoleLog,
    macLog,
    iosLog,
    log: consoleLog || macLog || iosLog,
    needsCleanup: false,
    remoteDirectory: null,
  };
}

function logDevice(device) {
  logItem(`OS: ${device.os}`);
  logItem(`Type: ${device.type}`);
  logItem(device.gdb ? `GDB: ${device.gdb}` : "GDB: Not found");
  logItem(device.lldb ? `LLDB: ${device.lldb}` : "LLDB: Not found");
  logItem(device.appinst ? `appinst: ${device.appinst}` : "appinst: Not found");
  logItem(
    device.ipainstaller
      ? `ipainstaller: ${device.ipainstaller}`
      : "ipainstaller: Not found",
  );
  logItem(
    device.consoleLog
      ? `Console Log: ${device.consoleLog}`
      : "Console Log: Not found",
  );
  logItem(
    device.macLog
      ? `Syslog (Mac): ${device.macLog}`
      : "Syslog (Mac): Not found",
  );
  logItem(
    device.iosLog
      ? `Syslog (iOS): ${device.iosLog}`
      : "Syslog (iOS): Not found",
  );
}

async function preflightDevice(options) {
  logHeader("Device Preflight");
  const result = await run(
    "ssh",
    [
      "-o",
      "BatchMode=yes",
      "-o",
      "ConnectTimeout=5",
      options.device,
      REMOTE_PROBE,
    ],
    { capture: true, stderr: "ignore" },
  ).catch(() => null);
  if (!result || !result.stdout.trim()) {
    throw new DeployError(
      `SSH connection to '${options.device}' failed\n       Run 'ssh ${options.device}' to debug the errors\n       Note: Key authentication is required for this script`,
    );
  }
  logItem("SSH Connection: OK");
  const device = deviceFromProbe(
    parseProbeOutput(result.stdout),
    options.device,
  );
  logDevice(device);
  return device;
}

function validatePlan(application, device) {
  if (device.type !== "mac" && device.type !== "ios") {
    throw new DeployError(
      `Unable to deploy to ${device.os || "this operating system"}; the SSH target must be a Mac or iPhone`,
    );
  }
  if (!device.home.startsWith("/")) {
    throw new DeployError(
      "Remote preflight did not return an absolute home directory",
    );
  }
  if (device.type === "mac") {
    if (application.ipaPath && !application.zipPath) {
      throw new DeployError("Unable to deploy an iOS app (ipa) to a Mac");
    }
    if (!application.zipPath) {
      throw new DeployError(
        `Remote Mac deployment requires a .zip payload. None found in ${application.directory}`,
      );
    }
  } else {
    if (!application.ipaPath) {
      throw new DeployError(
        `iPhone deployment requires an .ipa payload. None found in ${application.directory}`,
      );
    }
    if (!device.appinst && !device.ipainstaller) {
      throw new DeployError(
        "No iPhone installer found (appinst or ipainstaller).",
      );
    }
  }
}

async function confirmPlan(application, device, options) {
  logHeader("Deployment Summary");
  validatePlan(application, device);
  if (device.type === "mac") {
    logItem(
      `Action: Deploy ${application.appName} to Remote Mac (${device.device})`,
    );
    logItem(
      `Transfer: ${path.basename(application.zipPath)}, ${application.dsymPaths.length} dSYMs, and debugger inits`,
    );
  } else {
    logItem(
      `Action: Deploy ${application.appName} to Remote iPhone (${device.device})`,
    );
    logItem(`Transfer: ${path.basename(application.ipaPath)}`);
  }
  if (options.nonInteractive) {
    logItem("Continuing automatically (--yes set)");
    return true;
  }
  const prompt = readline.createInterface({
    input: process.stdin,
    output: process.stdout,
  });
  const controller = new AbortController();
  const abort = () => controller.abort();
  stopWaiters.add(abort);
  try {
    const answer = await prompt.question(
      "\nContinue with deployment? (Y/n): ",
      {
        signal: controller.signal,
      },
    );
    return !answer || /^y$/i.test(answer);
  } catch (error) {
    if (error.name === "AbortError") {
      throw new DeployError("Deployment interrupted", 130);
    }
    throw error;
  } finally {
    stopWaiters.delete(abort);
    prompt.close();
  }
}

async function prepareDebuggerInits(application) {
  if (!application.envFile) return;
  const variables = parseEnv(fs.readFileSync(application.envFile, "utf8"));
  application.tempDirectory = fs.mkdtempSync(
    path.join(os.tmpdir(), "altivec-deploy-"),
  );
  fs.chmodSync(application.tempDirectory, 0o700);
  application.gdbInitToUse = path.join(application.tempDirectory, "gdbinit");
  application.lldbInitToUse = path.join(application.tempDirectory, "lldbinit");
  const gdbTemplate = application.gdbInit
    ? fs.readFileSync(application.gdbInit, "utf8")
    : "";
  const lldbTemplate = application.lldbInit
    ? fs.readFileSync(application.lldbInit, "utf8")
    : "";
  fs.writeFileSync(
    application.gdbInitToUse,
    buildDebuggerInit(gdbTemplate, variables, "gdb", application.envFile),
    { mode: 0o600 },
  );
  fs.writeFileSync(
    application.lldbInitToUse,
    buildDebuggerInit(lldbTemplate, variables, "lldb", application.envFile),
    { mode: 0o600 },
  );
  logItem(
    `Generated debugger inits with env from ${path.basename(application.envFile)}`,
  );
}

function shellQuote(value) {
  return `'${String(value).replaceAll("'", `'"'"'`)}'`;
}

function remoteRun(device, command, options = {}) {
  const args = [...(options.tty ? ["-t"] : []), device.device, command];
  return run("ssh", args, options);
}

function logInstructions(type, device) {
  process.stdout.write(
    "\n***************************************************\n",
  );
  if (type === "debugger") {
    process.stdout.write(
      "  DEBUGGER INSTRUCTIONS:\n" +
        "  - Type 'run' to launch the app.\n" +
        "  - Press CTRL+C to pause the app.\n" +
        "  - Type 'kill' to kill the app.\n" +
        "  - Type 'quit' to exit the debugger.\n",
    );
  } else if (type === "logs") {
    process.stdout.write(
      "  LOG INSTRUCTIONS:\n  - Press CTRL+C to stop tailing logs.\n",
    );
  } else {
    process.stdout.write(
      "  NO LOGS FOUND:\n" +
        "  - The app has been launched on the remote Mac.\n" +
        "  - No system log was found to tail.\n" +
        "  - Press CTRL+C to stop the app and cleanup.\n",
    );
  }
  if (device) {
    if (device.type === "ios") {
      process.stdout.write(
        "  Note: Temporary files have been deleted, but\n" +
          "        the app will remain on the homescreen.\n",
      );
    } else {
      process.stdout.write(
        "  Note: Remote files will be deleted\n" +
          "        automatically after stopping.\n",
      );
    }
  }
  process.stdout.write(
    "***************************************************\n\n",
  );
}

function startLogTail(command, args) {
  const child = spawn(command, args, { stdio: "inherit" });
  child.once("error", (error) => {
    process.stderr.write(`[WARN] Unable to tail logs: ${error.message}\n`);
  });
  return child;
}

async function stopChild(child) {
  if (!child || child.exitCode !== null || child.signalCode) return;
  child.kill("SIGTERM");
  await new Promise((resolve) => {
    const timer = setTimeout(() => {
      if (child.exitCode === null && !child.signalCode) child.kill("SIGKILL");
    }, 2000);
    child.once("close", () => {
      clearTimeout(timer);
      resolve();
    });
  });
}

function createRemoteDirectory(device, parent) {
  const session = `${Date.now()}-${process.pid}-${Math.random().toString(16).slice(2, 10)}`;
  return path.posix.join(device.home, parent, session);
}

async function executeRemoteMac(application, device, options) {
  await prepareDebuggerInits(application);
  device.remoteDirectory = createRemoteDirectory(device, REMOTE_MAC_PARENT);
  await remoteRun(device, `mkdir -p ${shellQuote(device.remoteDirectory)}`);
  device.needsCleanup = true;
  const transfers = [application.zipPath, ...application.dsymPaths];
  if (application.gdbInitToUse) transfers.push(application.gdbInitToUse);
  if (application.lldbInitToUse) transfers.push(application.lldbInitToUse);
  logItem("Transferring files to remote Mac...");
  await run("scp", [
    "-O",
    "-r",
    ...transfers,
    `${device.device}:${shellQuote(`${device.remoteDirectory}/`)}`,
  ]);
  const zipName = path.basename(application.zipPath);
  logItem("Unzipping...");
  const unzip = await remoteRun(
    device,
    `cd ${shellQuote(device.remoteDirectory)} && unzip -l ${shellQuote(zipName)} | tail -1 | awk '{print $2}' && unzip -q -o ${shellQuote(zipName)}`,
    { capture: true },
  );
  const fileCount = unzip.stdout.trim().split(/\r?\n/)[0] || "unknown";
  logItem(`Unzipped (${fileCount} files)`);
  const remoteAppPath = path.posix.join(
    device.remoteDirectory,
    `${application.appName}.app`,
  );
  const remoteBinaryPath = path.posix.join(
    remoteAppPath,
    "Contents",
    "MacOS",
    application.appName,
  );
  if (!options.nonInteractive && device.lldb) {
    logInstructions("debugger", device);
    const remoteInit = path.posix.join(device.remoteDirectory, "lldbinit");
    const initArgument = application.lldbInitToUse
      ? `-s ${shellQuote(remoteInit)} `
      : "";
    await remoteRun(
      device,
      `${shellQuote(device.lldb)} ${initArgument}${shellQuote(remoteBinaryPath)}`,
      { tty: true },
    );
    return;
  }
  if (!options.nonInteractive && device.gdb) {
    logInstructions("debugger", device);
    const remoteInit = path.posix.join(device.remoteDirectory, "gdbinit");
    const initArgument = application.gdbInitToUse
      ? `-x ${shellQuote(remoteInit)} `
      : "";
    await remoteRun(
      device,
      `${shellQuote(device.gdb)} ${initArgument}${shellQuote(remoteBinaryPath)}`,
      { tty: true },
    );
    return;
  }
  if (!options.nonInteractive) {
    await remoteRun(device, `open ${shellQuote(remoteAppPath)}`);
    if (device.log) {
      logInstructions("logs", device);
      await remoteRun(
        device,
        `tail -f ${shellQuote(device.log)} | grep --line-buffered -- ${shellQuote(application.appName)}`,
      );
    } else {
      logInstructions("logsnone", device);
      await waitOrAbort(Infinity);
    }
    return;
  }
  logItem(
    `Executing ${application.appName} on remote Mac for ${options.timeout} seconds (--yes)...`,
  );
  let tail = null;
  if (device.log) {
    tail = startLogTail("ssh", [
      device.device,
      `tail -f ${shellQuote(device.log)} | grep --line-buffered -- ${shellQuote(application.appName)}`,
    ]);
    await waitOrAbort(1000, tail);
  }
  await remoteRun(device, `open ${shellQuote(remoteAppPath)}`);
  await waitOrAbort(options.timeout * 1000, tail);
  await stopChild(tail);
}

async function executeRemoteIphone(application, device, options) {
  device.remoteDirectory = createRemoteDirectory(device, REMOTE_IOS_PARENT);
  await remoteRun(device, `mkdir -p ${shellQuote(device.remoteDirectory)}`);
  device.needsCleanup = true;
  const ipaName = path.basename(application.ipaPath);
  const remoteIpa = path.posix.join(device.remoteDirectory, ipaName);
  await run("scp", [
    "-O",
    application.ipaPath,
    `${device.device}:${shellQuote(`${device.remoteDirectory}/`)}`,
  ]);
  const installer = device.appinst || device.ipainstaller;
  await remoteRun(device, `${shellQuote(installer)} ${shellQuote(remoteIpa)}`);
  await remoteRun(device, `rm -f ${shellQuote(remoteIpa)}`);
  if (!device.log) return;
  logInstructions("logs", device);
  process.stdout.write(`Tailing logs for ${application.appName}...\n`);
  if (options.nonInteractive) {
    process.stdout.write(
      `Tailing logs for ${options.timeout} seconds (--yes)...\n`,
    );
    const tail = startLogTail("ssh", [
      device.device,
      `tail -f ${shellQuote(device.log)} | grep --line-buffered -- ${shellQuote(application.appName)}`,
    ]);
    await waitOrAbort(options.timeout * 1000, tail);
    await stopChild(tail);
  } else {
    await remoteRun(
      device,
      `tail -f ${shellQuote(device.log)} | grep --line-buffered -- ${shellQuote(application.appName)}`,
    );
  }
}

async function cleanup(application, device) {
  if (device && device.needsCleanup && device.remoteDirectory) {
    if (device.type === "mac") {
      process.stdout.write("Stopping remote app...\n");
      await remoteRun(
        device,
        `killall ${shellQuote(application.appName)} 2>/dev/null || true`,
        { allowFailure: true },
      );
      process.stdout.write("Cleaning up remote Mac directory...\n");
    } else {
      process.stdout.write("Cleaning up remote iPhone directory...\n");
    }
    await remoteRun(device, `rm -rf ${shellQuote(device.remoteDirectory)}`, {
      allowFailure: true,
    });
  }
  if (application && application.tempDirectory) {
    fs.rmSync(application.tempDirectory, { recursive: true, force: true });
  }
}

async function main(argv = process.argv.slice(2)) {
  let application = null;
  let device = null;
  try {
    const options = parseArgs(argv);
    if (options.help) {
      process.stdout.write(`${usage()}\n`);
      return 0;
    }
    requireConfirmationTerminal(options);
    application = discoverApplication(options.inputPath);
    device = await preflightDevice(options);
    if (!(await confirmPlan(application, device, options))) {
      process.stdout.write("Aborted.\n");
      return 0;
    }
    if (device.type === "mac")
      await executeRemoteMac(application, device, options);
    else await executeRemoteIphone(application, device, options);
    return 0;
  } finally {
    await cleanup(application, device);
  }
}

if (require.main === module) {
  main()
    .then((status) => {
      process.exitCode = status;
    })
    .catch((error) => {
      logFail(error.message);
      if (process.argv.length === 2) process.stderr.write(`${usage()}\n`);
      process.exitCode = error.status || 1;
    });
}

module.exports = {
  DeployError,
  buildDebuggerInit,
  deviceFromProbe,
  findAppBundles,
  findEnvFile,
  parseArgs,
  parseEnv,
  parseProbeOutput,
  requireConfirmationTerminal,
  selectArtifact,
  shellQuote,
  usage,
  validatePlan,
};
