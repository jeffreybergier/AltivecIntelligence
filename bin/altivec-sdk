#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly script_dir
if [[ -r "$script_dir/../share/altivec-sdk/catalog.json" ]]; then
  default_catalog="$script_dir/../share/altivec-sdk/catalog.json"
else
  default_catalog=/altivec/share/altivec-sdk/catalog.json
fi
readonly default_catalog catalog_path="${ALTIVEC_SDK_CATALOG:-$default_catalog}"
readonly archive_dir="${ALTIVEC_SDK_ARCHIVE_DIR:-/altivec-sdk}"
readonly legacy_sdk_dir="${ALTIVEC_SDK_LEGACY_DIR:-/osxcross/legacy/target/SDK}"
readonly modern_sdk_dir="${ALTIVEC_SDK_MODERN_DIR:-/osxcross/modern/SDK}"

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

usage() {
  printf '%s\n' \
    'Usage:' \
    '  altivec-sdk help' \
    '  altivec-sdk status' \
    '  altivec-sdk preflight' \
    '  altivec-sdk install' \
    '  altivec-sdk uninstall' \
    '' \
    "Archive folder inside the container: ${archive_dir}" \
    'With Compose, this is the project folder ./.altivec-sdk on the host.' \
    '' \
    'Place these exact files in that folder:' \
    '  MacOSX10.5.sdk.tar.xz' \
    '  MacOSX11.3.sdk.tar.xz' \
    '  iPhoneOS8.4.sdk.tar.gz' \
    '' \
    'This tool never downloads SDKs. It verifies and installs local archives.' \
    'Set ALTIVEC_SDK_ARCHIVE_DIR to use a different archive folder.' \
    '' \
    'Compliance commands used by release automation:' \
    '  altivec-sdk audit [ROOT]' \
    '  altivec-sdk audit-image IMAGE' \
    '  altivec-sdk audit-repository [ROOT]'
}

require_exact_args() {
  local expected="$1"
  local message="$2"
  shift 2
  (($# == expected)) || die "$message"
}

require_tools() {
  local tool
  for tool in "$@"; do
    command -v "$tool" >/dev/null 2>&1 ||
      die "required command is missing: ${tool}"
  done
}

hash_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    die 'required command is missing: sha256sum or shasum'
  fi
}

file_bytes() {
  wc -c < "$1" | tr -d '[:space:]'
}

initialize_catalog() {
  require_tools jq
  [[ -r "$catalog_path" ]] || die "SDK catalog is missing: ${catalog_path}"
  jq -e '
    .schema == 3 and
    (.build_sdks | type == "array" and length == 3) and
    ([.build_sdks[].id] ==
      ["macos-10.5", "macos-11.3", "iphoneos-8.4"]) and
    all(.build_sdks[];
      (.platform == "macos" or .platform == "iphoneos") and
      (.version | type == "string" and length > 0) and
      (.archive | type == "string" and length > 0) and
      (.directory | type == "string" and test("[.]sdk$")) and
      (.sha256 | test("^[0-9a-f]{64}$")) and
      (.archive_bytes | type == "number" and . > 0 and floor == .) and
      (.format == "tar.xz" or .format == "tar.gz") and
      (.destination == "legacy" or .destination == "modern") and
      (.required_paths | type == "array" and length > 0) and
      (has("url") | not)) and
    (.prohibited_files | type == "array" and length > 0) and
    all(.prohibited_files[];
      (.id | type == "string" and length > 0) and
      (.bytes | type == "number" and . > 0 and floor == .) and
      (.sha256 | test("^[0-9a-f]{64}$")))
  ' "$catalog_path" >/dev/null || die "SDK catalog is invalid: ${catalog_path}"
}

sdk_entries() {
  jq -cr '.build_sdks[]' "$catalog_path"
}

entry_value() {
  jq -r "$2" <<< "$1"
}

sdk_parent() {
  case "$1" in
    legacy) printf '%s\n' "$legacy_sdk_dir" ;;
    modern) printf '%s\n' "$modern_sdk_dir" ;;
    *) die "unknown SDK destination: $1" ;;
  esac
}

archive_path() {
  printf '%s/%s\n' "$archive_dir" "$1"
}

receipt_path() {
  printf '%s/.altivec-sdk-%s.receipt\n' "$1" "$2"
}

validate_archive_paths() {
  local archive="$1"
  local format="$2"
  local expected_root="$3"
  local member normalized
  local -a list_args

  case "$format" in
    tar.xz) list_args=(-tJf) ;;
    tar.gz) list_args=(-tzf) ;;
    *)
      printf 'error: unsupported SDK archive format: %s\n' "$format" >&2
      return 1
      ;;
  esac

  if ! tar "${list_args[@]}" "$archive" >/dev/null; then
    printf 'error: invalid SDK archive: %s\n' "$archive" >&2
    return 1
  fi

  while IFS= read -r member; do
    normalized="${member#./}"
    case "$normalized" in
      /*|../*|*/../*|*/..|*/./*)
        printf 'error: unsafe path in SDK archive %s: %s\n' \
          "$archive" "$member" >&2
        return 1
        ;;
      "$expected_root"|"$expected_root"/*) ;;
      *)
        printf 'error: unexpected path in SDK archive %s: %s\n' \
          "$archive" "$member" >&2
        return 1
        ;;
    esac
  done < <(tar "${list_args[@]}" "$archive")
}

validate_installed_sdk() {
  local entry="$1"
  local sdk_path="$2"
  local required

  [[ -d "$sdk_path" && ! -L "$sdk_path" ]] || return 1
  while IFS= read -r required; do
    [[ -e "$sdk_path/$required" ]] || return 1
  done < <(jq -r '.required_paths[]' <<< "$entry")
}

verify_entry_archive() {
  local entry="$1"
  local filename expected expected_bytes actual actual_bytes archive format directory

  filename="$(entry_value "$entry" '.archive')"
  expected="$(entry_value "$entry" '.sha256')"
  expected_bytes="$(entry_value "$entry" '.archive_bytes')"
  format="$(entry_value "$entry" '.format')"
  directory="$(entry_value "$entry" '.directory')"
  archive="$(archive_path "$filename")"

  if [[ ! -f "$archive" || -L "$archive" ]]; then
    printf 'error: required SDK archive is missing: %s\n' "$archive" >&2
    return 1
  fi
  actual_bytes="$(file_bytes "$archive")"
  if [[ "$actual_bytes" != "$expected_bytes" ]]; then
    printf 'error: SDK size mismatch for %s: got %s; expected %s\n' \
      "$archive" "$actual_bytes" "$expected_bytes" >&2
    return 1
  fi
  actual="$(hash_file "$archive")"
  if [[ "$actual" != "$expected" ]]; then
    printf 'error: SDK checksum mismatch for %s: got %s; expected %s\n' \
      "$archive" "$actual" "$expected" >&2
    return 1
  fi
  validate_archive_paths "$archive" "$format" "$directory" || return 1
  printf '%s\n' "$archive"
}

archive_status() {
  local entry="$1"
  local filename expected expected_bytes archive actual actual_bytes

  filename="$(entry_value "$entry" '.archive')"
  expected="$(entry_value "$entry" '.sha256')"
  expected_bytes="$(entry_value "$entry" '.archive_bytes')"
  archive="$(archive_path "$filename")"
  if [[ ! -e "$archive" && ! -L "$archive" ]]; then
    printf 'missing\n'
  elif [[ ! -f "$archive" || -L "$archive" ]]; then
    printf 'invalid\n'
  else
    actual_bytes="$(file_bytes "$archive")"
    actual="$(hash_file "$archive")"
    if [[ "$actual_bytes" == "$expected_bytes" && "$actual" == "$expected" ]]; then
      printf 'available\n'
    else
      printf 'invalid\n'
    fi
  fi
}

installation_status() {
  local entry="$1"
  local directory destination parent sdk_path receipt expected

  directory="$(entry_value "$entry" '.directory')"
  destination="$(entry_value "$entry" '.destination')"
  expected="$(entry_value "$entry" '.sha256')"
  parent="$(sdk_parent "$destination")"
  sdk_path="$parent/$directory"
  receipt="$(receipt_path "$parent" "$directory")"
  if validate_installed_sdk "$entry" "$sdk_path" &&
      [[ -f "$receipt" && ! -L "$receipt" ]] &&
      grep -Fqx "$expected" "$receipt"; then
    printf 'installed\n'
  elif [[ -e "$sdk_path" || -L "$sdk_path" ]]; then
    printf 'invalid\n'
  else
    printf 'missing\n'
  fi
}

command_status() {
  local entry directory archive source_state install_state

  require_tools awk grep tr wc
  printf 'Archive folder: %s\n\n' "$archive_dir"
  printf '%-16s %-29s %-10s %-12s\n' \
    SDK ARCHIVE SOURCE INSTALLATION
  while IFS= read -r entry; do
    directory="$(entry_value "$entry" '.directory')"
    archive="$(entry_value "$entry" '.archive')"
    source_state="$(archive_status "$entry")"
    install_state="$(installation_status "$entry")"
    printf '%-16s %-29s %-10s %-12s\n' \
      "${directory%.sdk}" "$archive" "$source_state" "$install_state"
  done < <(sdk_entries)
}

command_preflight() {
  local entry archive
  local rc=0

  require_tools awk tar tr wc
  printf 'Checking SDK archives in %s...\n' "$archive_dir"
  while IFS= read -r entry; do
    if archive="$(verify_entry_archive "$entry")"; then
      printf '  available: %s\n' "${archive##*/}"
    else
      rc=1
    fi
  done < <(sdk_entries)
  if [[ "$rc" -ne 0 ]]; then
    printf 'error: SDK archive preflight failed\n' >&2
    return 1
  fi
  printf 'SDK archive preflight passed.\n'
}

validate_install_destination() {
  local entry="$1"
  local directory destination parent sdk_path receipt expected

  directory="$(entry_value "$entry" '.directory')"
  destination="$(entry_value "$entry" '.destination')"
  expected="$(entry_value "$entry" '.sha256')"
  parent="$(sdk_parent "$destination")"
  sdk_path="$parent/$directory"
  receipt="$(receipt_path "$parent" "$directory")"
  if [[ ! -e "$sdk_path" && ! -L "$sdk_path" ]]; then
    return 0
  fi
  if validate_installed_sdk "$entry" "$sdk_path" &&
      [[ -f "$receipt" && ! -L "$receipt" ]] &&
      grep -Fqx "$expected" "$receipt"; then
    return 0
  fi
  printf 'error: existing SDK is incomplete or unverified: %s\n' \
    "$sdk_path" >&2
  printf 'error: run altivec-sdk uninstall before installing again\n' >&2
  return 1
}

install_entry() {
  local entry="$1"
  local directory destination parent sdk_path receipt archive expected format
  local staging extracted lock_file
  local -a extract_args

  directory="$(entry_value "$entry" '.directory')"
  destination="$(entry_value "$entry" '.destination')"
  expected="$(entry_value "$entry" '.sha256')"
  format="$(entry_value "$entry" '.format')"
  archive="$(archive_path "$(entry_value "$entry" '.archive')")"
  parent="$(sdk_parent "$destination")"
  sdk_path="$parent/$directory"
  receipt="$(receipt_path "$parent" "$directory")"
  mkdir -p "$parent"

  lock_file="$parent/.altivec-sdk.lock"
  exec 9>"$lock_file"
  flock 9

  if validate_installed_sdk "$entry" "$sdk_path" &&
      [[ -f "$receipt" && ! -L "$receipt" ]] &&
      grep -Fqx "$expected" "$receipt"; then
    printf 'SDK already installed: %s\n' "$sdk_path"
    flock -u 9
    return 0
  fi

  staging="$(mktemp -d "$parent/.altivec-sdk.install.XXXXXX")"
  case "$format" in
    tar.xz) extract_args=(--no-same-owner -xJf) ;;
    tar.gz) extract_args=(--no-same-owner -xzf) ;;
  esac
  if ! tar "${extract_args[@]}" "$archive" -C "$staging"; then
    rm -rf -- "$staging"
    die "failed to extract SDK archive: ${archive}"
  fi
  extracted="$staging/$directory"
  if ! validate_installed_sdk "$entry" "$extracted"; then
    rm -rf -- "$staging"
    die "extracted SDK failed validation: ${directory}"
  fi
  mv "$extracted" "$sdk_path"
  rmdir "$staging"
  printf '%s\n' "$expected" > "$receipt.tmp"
  mv "$receipt.tmp" "$receipt"
  printf 'Installed SDK: %s\n' "$sdk_path"
  flock -u 9
}

command_install() {
  local entry
  local rc=0

  require_tools awk flock grep mkdir mktemp mv rm rmdir tar tr wc
  command_preflight
  while IFS= read -r entry; do
    validate_install_destination "$entry" || rc=1
  done < <(sdk_entries)
  [[ "$rc" -eq 0 ]] || return 1
  while IFS= read -r entry; do
    install_entry "$entry"
  done < <(sdk_entries)
}

uninstall_entry() {
  local entry="$1"
  local directory destination parent sdk_path receipt

  directory="$(entry_value "$entry" '.directory')"
  destination="$(entry_value "$entry" '.destination')"
  parent="$(sdk_parent "$destination")"
  sdk_path="$parent/$directory"
  receipt="$(receipt_path "$parent" "$directory")"
  case "$sdk_path" in
    "$legacy_sdk_dir"/*.sdk|"$modern_sdk_dir"/*.sdk) ;;
    *) die "refusing to uninstall unexpected SDK path: ${sdk_path}" ;;
  esac
  if [[ -e "$sdk_path" || -L "$sdk_path" ]]; then
    rm -rf -- "$sdk_path"
    printf 'Uninstalled SDK: %s\n' "$sdk_path"
  else
    printf 'SDK not installed: %s\n' "$sdk_path"
  fi
  rm -f -- "$receipt"
}

command_uninstall() {
  local entry

  require_tools rm
  while IFS= read -r entry; do
    uninstall_entry "$entry"
  done < <(sdk_entries)
  printf 'Source archives left untouched in %s.\n' "$archive_dir"
}

audit_root() {
  local root="${1:-/}"
  local match file size actual expected label

  [[ -d "$root" ]] || die "audit root is not a directory: ${root}"
  match="$(find "$root" -xdev \
    \( -type d -iname '*.sdk' -o -type f -iname '*.sdk.tar.*' \
       -o -type f -iname '*arclite*' \
       -o -type f -name 'SDKSettings.plist' \) -print -quit 2>/dev/null)"
  [[ -z "$match" ]] || die "Apple SDK or ARCLite content found: ${match}"

  while IFS=$'\t' read -r size expected label; do
    while IFS= read -r -d '' file; do
      actual="$(hash_file "$file")"
      [[ "$actual" != "$expected" ]] ||
        die "prohibited Apple build input found (${label}): ${file}"
    done < <(find "$root" -xdev -type f -size "${size}c" -print0 2>/dev/null)
  done < <(jq -r '
    (.build_sdks[] | [.archive_bytes, .sha256, ("SDK archive " + .archive)]),
    (.prohibited_files[] | [.bytes, .sha256, .id]) | @tsv
  ' "$catalog_path")
  printf 'SDK-free filesystem verified: %s\n' "$root"
}

audit_layer_tar() {
  local layer="$1"

  python3 - "$layer" "$catalog_path" <<'PY'
import hashlib
import json
import pathlib
import re
import sys
import tarfile

layer_path, catalog_path = sys.argv[1:]
with open(catalog_path, encoding="utf-8") as stream:
    catalog = json.load(stream)

restricted = {}
for entry in catalog["build_sdks"]:
    restricted[(entry["archive_bytes"], entry["sha256"])] = (
        f"SDK archive {entry['archive']}"
    )
for entry in catalog["prohibited_files"]:
    restricted[(entry["bytes"], entry["sha256"])] = entry["id"]
restricted_sizes = {size for size, _ in restricted}

sdk_path = re.compile(r"(^|/)[^/]*[.]sdk(/|$)", re.IGNORECASE)
sdk_archive = re.compile(r"[.]sdk[.]tar[.](gz|xz)$", re.IGNORECASE)

with tarfile.open(layer_path, "r:*") as archive:
    for member in archive:
        name = member.name.removeprefix("./")
        lower = name.lower()
        if (
            sdk_path.search(name)
            or sdk_archive.search(name)
            or "arclite" in lower
            or pathlib.PurePosixPath(name).name == "SDKSettings.plist"
        ):
            raise SystemExit(
                f"Apple SDK or ARCLite path found in image layer: {member.name}"
            )
        if not member.isfile() or member.size not in restricted_sizes:
            continue
        stream = archive.extractfile(member)
        if stream is None:
            continue
        digest = hashlib.file_digest(stream, "sha256").hexdigest()
        label = restricted.get((member.size, digest))
        if label:
            raise SystemExit(
                f"prohibited Apple build input found in image layer "
                f"({label}): {member.name}"
            )
PY
}

audit_image() {
  local image="$1"
  local temporary archive layer

  [[ -n "$image" ]] || die 'audit-image requires an image reference'
  temporary="$(mktemp -d "${TMPDIR:-/tmp}/altivec-sdk-image.XXXXXX")"
  trap 'rm -rf -- "$temporary"' RETURN
  archive="$temporary/image.tar"
  docker image save "$image" -o "$archive"
  tar -xf "$archive" -C "$temporary" manifest.json

  while IFS= read -r layer; do
    [[ "$layer" =~ ^([0-9a-f]{64}/layer[.]tar|blobs/sha256/[0-9a-f]{64})$ ]] ||
      die "unexpected image layer path: ${layer}"
    tar -xf "$archive" -C "$temporary" "$layer"
    audit_layer_tar "$temporary/$layer"
    rm -f -- "$temporary/$layer"
  done < <(jq -r '.[].Layers[]' "$temporary/manifest.json")

  rm -rf -- "$temporary"
  trap - RETURN
  printf 'SDK-free image layers verified: %s\n' "$image"
}

audit_repository() {
  local root="${1:-$PWD}"
  local tracked_match history_match

  [[ -d "$root/.git" ]] || die "repository root is missing .git: ${root}"
  tracked_match="$(git -C "$root" ls-files | grep -Ei \
    '(^|/)([^/]*[.]sdk($|/)|[^/]*[.]sdk[.]tar[.](gz|xz)$|[^/]*arclite[^/]*$|[^/]*[.]a$)' \
    | head -n 1 || true)"
  [[ -z "$tracked_match" ]] ||
    die "prohibited tracked repository path found: ${tracked_match}"

  history_match="$(git -C "$root" rev-list --objects --all | grep -Ei \
    ' (.*[/])?([^/]*[.]sdk($|/)|[^/]*[.]sdk[.]tar[.](gz|xz)$|[^/]*arclite[^/]*$|[^/]*[.]a$)' \
    | head -n 1 || true)"
  [[ -z "$history_match" ]] ||
    die "prohibited repository-history path found: ${history_match}"

  python3 - "$root" "$catalog_path" <<'PY'
import hashlib
import json
import subprocess
import sys

root, catalog_path = sys.argv[1:]
with open(catalog_path, encoding="utf-8") as stream:
    catalog = json.load(stream)
prohibited = {
    entry["sha256"] for entry in catalog["build_sdks"]
} | {
    entry["sha256"] for entry in catalog["prohibited_files"]
}

revision_output = subprocess.check_output(
    ["git", "-C", root, "rev-list", "--objects", "--all"], text=True
)
object_ids = [line.split(maxsplit=1)[0] for line in revision_output.splitlines()]
checked = subprocess.check_output(
    ["git", "-C", root, "cat-file", "--batch-check=%(objectname) %(objecttype)"],
    input="".join(f"{object_id}\n" for object_id in object_ids),
    text=True,
)
blob_ids = [
    line.split()[0] for line in checked.splitlines() if line.endswith(" blob")
]

process = subprocess.Popen(
    ["git", "-C", root, "cat-file", "--batch"],
    stdin=subprocess.PIPE,
    stdout=subprocess.PIPE,
)
assert process.stdin is not None and process.stdout is not None
for object_id in blob_ids:
    process.stdin.write(f"{object_id}\n".encode())
    process.stdin.flush()
    header = process.stdout.readline().decode().rstrip("\n")
    returned_id, object_type, size_text = header.rsplit(" ", 2)
    if returned_id != object_id or object_type != "blob":
        raise SystemExit(f"unexpected git cat-file response: {header}")
    remaining = int(size_text)
    digest = hashlib.sha256()
    while remaining:
        chunk = process.stdout.read(min(remaining, 1024 * 1024))
        if not chunk:
            raise SystemExit(f"truncated Git blob: {object_id}")
        digest.update(chunk)
        remaining -= len(chunk)
    if process.stdout.read(1) != b"\n":
        raise SystemExit(f"invalid Git blob terminator: {object_id}")
    if digest.hexdigest() in prohibited:
        raise SystemExit(
            f"prohibited Apple blob found in repository history: {object_id}"
        )

process.stdin.close()
if process.wait() != 0:
    raise SystemExit("git cat-file failed while auditing repository history")
PY

  printf 'Apple SDK/ARCLite-free Git repository verified: %s\n' "$root"
}

command_name="${1:-}"
case "$command_name" in
  -h|--help|help)
    require_exact_args 1 'help takes no arguments' "$@"
    usage
    exit 0
    ;;
  '')
    usage >&2
    exit 2
    ;;
esac

initialize_catalog
case "$command_name" in
  status)
    require_exact_args 1 'status takes no arguments' "$@"
    command_status
    ;;
  preflight)
    require_exact_args 1 'preflight takes no arguments' "$@"
    command_preflight
    ;;
  install)
    require_exact_args 1 'install takes no arguments' "$@"
    command_install
    ;;
  uninstall)
    require_exact_args 1 'uninstall takes no arguments' "$@"
    command_uninstall
    ;;
  audit)
    (($# <= 2)) || die 'audit accepts at most one root'
    require_tools awk find
    audit_root "${2:-/}"
    ;;
  audit-image)
    require_exact_args 2 'audit-image requires exactly one image' "$@"
    require_tools docker jq mktemp python3 rm tar
    audit_image "$2"
    ;;
  audit-repository)
    (($# <= 2)) || die 'audit-repository accepts at most one root'
    require_tools git grep head python3
    audit_repository "${2:-$PWD}"
    ;;
  *)
    usage >&2
    printf 'error: unknown command: %s\n' "$command_name" >&2
    exit 2
    ;;
esac
